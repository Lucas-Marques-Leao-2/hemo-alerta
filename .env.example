DATABASE_URL="postgresql://docker:docker@localhost:7085/hemoalerta?schema=public"
CRON_SECRET=""

# Better Auth — gere o segredo com `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# URL pública da aplicação (em produção, o domínio real)
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare Email Sending — envio das campanhas de convocação.
# O domínio remetente (hemoal.gepetojj.com) precisa estar habilitado no
# Email Sending da conta. O token precisa da permissão de envio de e-mails.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_EMAIL_API_TOKEN=""
# Opcional: URL pública usada nos links dos e-mails (padrão: BETTER_AUTH_URL).
APP_URL=""
