model Donor {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  bloodType      BloodType
  lastDonationAt DateTime? @db.Date
  // Preferência do doador: quando falso, não entra em nenhuma convocação.
  acceptsCampaigns Boolean @default(true)

  deliveries CampaignDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bloodType])
  @@map("donors")
}
